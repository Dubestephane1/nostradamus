# Cache static assets aggressively (immutable since hashed/versioned paths)
/images/*
  Cache-Control: public, max-age=31536000, immutable

/css/*
  Cache-Control: public, max-age=31536000, immutable

/js/*
  Cache-Control: public, max-age=31536000, immutable

/style.css
  Cache-Control: public, max-age=31536000, immutable

# Long cache for data JSON (quatrain collections)
/js/data/*
  Cache-Control: public, max-age=86400

# HTML documents: short cache to allow updates quickly
/index.html
  Cache-Control: public, max-age=3600

/c*/q*/*
  Cache-Control: public, max-age=3600

# Security headers
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin